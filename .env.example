# Copy to .env and fill in. Never commit the real .env or service account file.

GROQ_API_KEY=

FIREBASE_PROJECT_ID=
# Path to the downloaded service account JSON (Firebase console > Project settings >
# Service accounts > Generate new private key). Keep this file out of git.
FIREBASE_SERVICE_ACCOUNT_JSON=./serviceAccountKey.json

# Ports (defaults shown)
API_PORT=8000
TWIN_SERVICE_PORT=8100
SIMULATOR_PORT=8200

TWIN_SERVICE_URL=http://localhost:8100
API_BASE_URL=http://localhost:8000
