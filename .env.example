# Copy to .env and fill in. Never commit the real .env.

# Cohere (https://dashboard.cohere.com/api-keys) - used for the agents' tool-calling chat
# model and for the RAG knowledge-base embeddings.
COHERE_API_KEY=
# Optional overrides
COHERE_MODEL=command-a-03-2025
COHERE_EMBED_MODEL=embed-english-v3.0

# Local SQLite document store (default: data/diagnostics.db)
# DIAGNOSTICS_DB_PATH=./data/diagnostics.db

# Ports (defaults shown)
API_PORT=8000
TWIN_SERVICE_PORT=8100
SIMULATOR_PORT=8200

TWIN_SERVICE_URL=http://127.0.0.1:8100
API_BASE_URL=http://127.0.0.1:8000
SIMULATOR_URL=http://127.0.0.1:8200

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Simulator: seconds between replayed telemetry rows per asset
SIMULATOR_TICK_SECONDS=3

# Scheduler cadence. The diagnostic sweep is the expensive one (several Cohere
# calls per asset per tick: diagnose/predict/recommend/self-heal) - Cohere trial keys
# are limited to ~20 chat calls/minute and 1000/month, so don't set this too low for a
# fleet of more than a few assets. The resolution sweep is a plain store check
# (no LLM call), safe to run often.
DIAGNOSTIC_SWEEP_SECONDS=180
DETECTION_SWEEP_SECONDS=30
RESOLUTION_SWEEP_SECONDS=20
