rules_version = '2';

// The dashboard reads Firestore directly from the browser (no login flow - see
// master-build-prompt-full.md section 1), but never writes: every write in this
// platform goes through the backend's service account (which bypasses these
// rules entirely), via the ingestion API, the MCP tools, or the scheduler jobs.
// So client access only ever needs to be read-only.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
